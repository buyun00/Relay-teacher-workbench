{
  "name": "hermes-classroom-client",
  "productName": "Hermes Classroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "课堂连接：设备录音归档、可靠传输和教室操作端",
  "author": "Teacher workbench",
  "license": "UNLICENSED",
  "main": "electron/bootstrap.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "build:content": "node scripts/build-content.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "check": "npm run build && npm test && npm run test:ui",
    "pack:local": "node scripts/configure-release.cjs && npm run build && npm run build:content && electron-builder --config electron-builder.local.cjs --win nsis --x64 --publish never",
    "pack:win": "node scripts/configure-release.cjs && npm run build && npm run build:content && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never",
    "pack:dir": "node scripts/configure-release.cjs && npm run build && npm run build:content && electron-builder --config electron-builder.cjs --win --x64 --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "katex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2",
    "typescript": "^6.0.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "ink.jiayan.classroom-bridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "runtime-manifest.json"
    ],
    "asar": true,
    "artifactName": "Hermes-Classroom-${version}-${arch}-Setup.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "课堂连接"
    }
  }
}
